{
  "name": "budgets-cost-centers-service",
  "version": "0.1.0",
  "private": true,
  "description": "API Extension: budget snapshot on carts, order guard, cost objects on quotes",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm --prefix ../core install --include=dev && npm --prefix ../core run build && npm --prefix ../shared install --include=dev && npm --prefix ../shared run build && rm -rf build && tsc -p tsconfig.json",
    "start": "node build/index.js",
    "test": "jest",
    "connector:post-deploy": "node build/connector/post-deploy.js",
    "connector:pre-undeploy": "node build/connector/pre-undeploy.js",
    "pretest": "npm --prefix ../shared install --include=dev --no-audit --no-fund"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^9.7.0",
    "@commercetools/ts-client": "^5.1.1",
    "budgets-cost-centers-core": "file:../core",
    "budgets-cost-centers-shared": "file:../shared",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "msw": "^2.15.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
